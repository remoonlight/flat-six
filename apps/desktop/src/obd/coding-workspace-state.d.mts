export type CodingField = { id:string;name:string;group:string;sourceGroup?:string;description?:string;editable:boolean;currentOptionId:string|null;currentDisplay:string;options:{id:string;label:string}[];numeric?:{minimum:string;maximum:string;currentValue:string|null;unit:string};text?:{length:number;minimumLength?:number;termination?:'ZERO';encoding:'ASCII'|'ISO-8859-1'|'ISO-8859-2';currentValue:string|null} };
export function codingFieldName(field:CodingField):string;
export type CodingSnapshot = {ecu:string;readId:string;identity:{generation:'981'|'982';vin:string;ecu:string;hardware:string;software:string};sourceHash:string;completeOriginal:true;sourceQualified:true;freshRead:true;desktopBackupSaved:true;desktopPath?:string;canWrite:boolean;canRestore:boolean;canPreviewRestore?:boolean;fields:CodingField[]};
export type CodingEdit={fieldId:string;name:string;label:string;unresolved:boolean}&({optionId:string;physicalValue?:never;textValue?:never}|{physicalValue:string;optionId?:never;textValue?:never}|{textValue:string;optionId?:never;physicalValue?:never});
export type CodingReviewChange={fieldId:string}&({beforeOptionId:string|null;targetOptionId:string;beforePhysicalValue?:never;targetPhysicalValue?:never;beforeTextValue?:never;targetTextValue?:never}|{beforePhysicalValue:string|null;targetPhysicalValue:string;beforeOptionId?:never;targetOptionId?:never;beforeTextValue?:never;targetTextValue?:never}|{beforeTextValue:string|null;targetTextValue:string;beforeOptionId?:never;targetOptionId?:never;beforePhysicalValue?:never;targetPhysicalValue?:never});
export type CodingReviewInput={id:string;readId:string;mode:'edit'|'restore';canExecute:boolean;changes:CodingReviewChange[];conditions:string[];rawDiffs:{name:string;beforeHex:string;targetHex:string}[]};
export type CodingReview=Omit<CodingReviewInput,'changes'>&{changes:(CodingReviewInput['changes'][number]&{name:string;before:string;target:string})[]};
export type CodingResultInput={reviewId:string;items:({fieldId:string;writeState:'succeeded'|'failed'|'unexecuted'|'unconfirmed'}&({readbackOptionId:string|null;readbackPhysicalValue?:never;readbackTextValue?:never}|{readbackPhysicalValue:string|null;readbackOptionId?:never;readbackTextValue?:never}|{readbackTextValue:string|null;readbackOptionId?:never;readbackPhysicalValue?:never}))[];snapshot?:CodingSnapshot};
export type CodingResult={items:(CodingResultInput['items'][number]&{name:string;before:string;target:string;readback:string|null;matched:boolean})[]};
export type CodingDraft={snapshot:CodingSnapshot|null;edits:CodingEdit[];numericInputs:Record<string,string>;textInputs:Record<string,string>;stale:boolean;mode:'edit'|'restore';review:CodingReview|null;result:CodingResult|null};
