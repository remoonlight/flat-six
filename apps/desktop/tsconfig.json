{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "types": ["vite/client"],
    "resolveJsonModule": true,
    "paths": {
      "@can-topology": ["../../data/seed/diagnostics/can-topology.v1.json"]
    }
  },
  "include": ["src"]
}
